
# ═══ J.A.R.V.I.S. — configurações ═══
# Copie este arquivo com o nome .env (no PC) ou cadastre estas variáveis
# em Render → seu serviço → Environment (na nuvem).

# OBRIGATÓRIA — cérebro + ouvido reserva (grátis): https://console.groq.com/keys
GROQ_API_KEY=

# Como o Jarvis te chama
NOME_DONO=senhor

# Sua cidade (clima no painel e nas respostas)
CIDADE_PADRAO=São José dos Campos

# Deixar o Jarvis MAIS INTELIGENTE (opcional):
# 1) use um modelo mais forte no Groq:
# GROQ_MODELO=openai/gpt-oss-120b
# 2) ou adicione uma chave do Gemini (tem plano grátis e é bem esperto) e
#    coloque CEREBRO_PRINCIPAL=gemini para ele pensar com o Gemini:
GEMINI_API_KEY=
OPENAI_API_KEY=
# CEREBRO_PRINCIPAL=gemini

# Muse: o Jarvis espera o Muse responder por até 25 s quando ele está conectado.
# Para nunca usar o Muse, troque para: desligado
MUSE_MODO=ligado
MUSE_ESPERA_MS=25000

# Velocidade da voz Faber (menor = mais rápido)
VOZ_VELOCIDADE=0.92

# (Opcional) Modelo de visão do Groq (multimodal), se "ver a tela" der erro de modelo
GROQ_VISAO_MODELO=qwen/qwen3.8-27b

# (Opcional) Aparelhos da casa na nuvem — gerado pela tela "Casa" (botão Copiar para o Render)
CASA_JSON=

# (Opcional) VOZ PREMIUM estilo dos vídeos — ElevenLabs (tem plano grátis):
# https://elevenlabs.io -> Profile -> API Key. Sem isso ele usa a voz Faber (grátis).
ELEVENLABS_API_KEY=
# Voz grave masculina padrão (Adam). Troque pelo ID de outra voz se quiser.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
