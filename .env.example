# ═══ J.A.R.V.I.S. — configurações ═══
# Copie este arquivo com o nome .env (no PC) ou cadastre estas variáveis
# em Render → seu serviço → Environment (na nuvem).

# OBRIGATÓRIA — cérebro + ouvido reserva (grátis): https://console.groq.com/keys
GROQ_API_KEY=

# Como o Jarvis te chama
NOME_DONO=senhor

# Sua cidade (clima no painel e nas respostas)
CIDADE_PADRAO=Maceió

# Deixar o Jarvis MAIS INTELIGENTE (opcional):
# 1) use um modelo mais forte no Groq:
# GROQ_MODELO=meta-llama/llama-4-maverick-17b-128e-instruct
# 2) ou adicione uma chave do Gemini (tem plano grátis e é bem esperto) e
#    coloque CEREBRO_PRINCIPAL=gemini para ele pensar com o Gemini:
GEMINI_API_KEY=
# 3) ou use o CLAUDE como cérebro (muito bom, mas é PAGO — sem plano grátis):
#    chave em https://console.anthropic.com -> API Keys ; e CEREBRO_PRINCIPAL=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-3-5-sonnet-latest
OPENAI_API_KEY=
# CEREBRO_PRINCIPAL=gemini

# MODO RÁPIDO (padrão): o cérebro é o Groq, que responde em 1-2 s.
# O Muse vem DESLIGADO porque ele é lento. Para usar o Muse como cérebro,
# troque para: ligado  (e deixe a conversa do Muse aberta vigiando a fila).
MUSE_MODO=desligado
# Quanto tempo esperar o Muse antes de o Groq assumir (só vale se MUSE_MODO=ligado).
MUSE_ESPERA_MS=6000

# Velocidade da voz Faber (menor = mais rápido)
VOZ_VELOCIDADE=0.92

# (Opcional) Modelo de visão do Groq, se "ver a tela" der erro de modelo
GROQ_VISAO_MODELO=meta-llama/llama-4-scout-17b-16e-instruct

# (Opcional) Aparelhos da casa na nuvem — gerado pela tela "Casa" (botão Copiar para o Render)
CASA_JSON=

# (Opcional) VOZ PREMIUM estilo dos vídeos — ElevenLabs (tem plano grátis):
# https://elevenlabs.io -> Profile -> API Key. Sem isso ele usa a voz Faber (grátis).
ELEVENLABS_API_KEY=
# Voz grave masculina padrão (Adam). Troque pelo ID de outra voz se quiser.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
